.DS_Store
.claude/settings.local.json
workflow_record.md

# 依赖与工具缓存
node_modules/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# 原书与转换出的全文（版权内容，不提交）
books/*/source.*
books/*/*.epub
books/*/*.pdf
books/*/chapters/

# 配音缓存与生成的音视频
books/*/cache/
*.wav
*.mp4

# 期目录的产物目录：命令为这一期生成的全部文件（ADR-0013）
books/*/*/*/out/

# Remotion 读的这一期文件：`pixelbook stage` 从期目录复制过去
video/public/episode/
# 在 video/ 里手动渲染的样张、样片（npx remotion render/still 的默认目录）
video/out/
# 音色试听：不属于任何一本书（ADR-0013）
voices/audition/
# 选定的参考音频要提交（ADR-0005：音色一致）
!voices/*.wav
# 音效要提交（#37）：wav 和生成它的 jsfxr 参数放在一起
!video/public/sfx/*.wav
# 片头片尾的音轨要提交（#50、#51）：由各自目录里的 make_audio.py 生成，测试核对它和重新生成的一致
!video/public/intro/*.wav
!video/public/outro/*.wav
# 片尾的配音是用户录好的，音轨脚本读它们
!video/src/outro/*/voice/*.wav
# 配乐文件只留在本机，不进 Git（spec #16 修订四，#53）；获取方法见目录里的 README.md
video/public/music/*
!video/public/music/README.md
